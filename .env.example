# archolith-bench configuration
# Copy to .env and fill in values

# DeepSeek API key (required for proxy and direct runs)
UPSTREAM_API_KEY=sk-your-key-here

# Proxy endpoint (default: local proxy)
PROXY_URL=http://localhost:9801/v1

# Direct upstream for baseline comparison
UPSTREAM_BASE_URL=https://api.deepseek.com/v1

# Model used for benchmark conversations
BENCHMARK_MODEL=deepseek-chat
